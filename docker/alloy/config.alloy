// Ship the logs of this compose project's containers to Loki.
discovery.docker "containers" {
  host = "unix:///var/run/docker.sock"
  // only this project: never read logs of other containers on the machine
  filter {
    name   = "label"
    values = ["com.docker.compose.project=ratelimiter"]
  }
}

discovery.relabel "containers" {
  targets = []

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "service"
  }
}

loki.source.docker "containers" {
  host          = "unix:///var/run/docker.sock"
  targets       = discovery.docker.containers.targets
  relabel_rules = discovery.relabel.containers.rules
  forward_to    = [loki.process.app.receiver]
}

// The app logs JSON: lift "level" into a label so Grafana can filter and colour by it.
// Nest calls info "log"; rename it so Grafana recognises the level.
loki.process "app" {
  stage.match {
    selector = "{service=\"app\"}"

    stage.json {
      expressions = { level = "level" }
    }
    stage.replace {
      source     = "level"
      expression = "^(log)$"
      replace    = "info"
    }
    stage.labels {
      values = { level = "" }
    }
  }
  forward_to = [loki.write.local.receiver]
}

loki.write "local" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
